Bootstrap: docker

# This sha corresponds to ros:humble-ros-base-jammy from august 17 2024
FROM: ros@sha256:80a4f6329aad64f14b600133cb3fd279d0bf666feeca5abef3f10bb41b0916ea

%post
    # Allow sudo by disabling 'no new privileges'
    echo "Defaults !noexec,!no_new_privs" >> /etc/sudoers
    
    # Update and install dependencies
    apt-get update && apt-get install -y \
        build-essential \
        bash-completion \
        curl \
        gdb \
        cmake \
        gcc \
        gedit \
        git \
        gitk \
        htop \
        libcanberra-gtk-module \
        less \
        locales \
        lsb-release \
        make \
        man \
        mercurial \
        nano \
        python3-dev \
        python3-pip \
        python3-venv \
        libpython3.10 \
        libpython3.10-dev \
        libglu1-mesa \
        x11-xserver-utils \
        python3-colcon-common-extensions \
        locales \
        wget \
        curl \
        gnupg2 \
        lsb-release \
        ssh \
        sudo \
        terminator \
        vim \
        wget \
        xterm \
        ros-humble-diagnostic-updater \
        ros-humble-rqt \
        ros-humble-xacro \
        ros-humble-rclpy \

    rm -rf /var/lib/apt/lists/*

    # Optional Packages:
            # ros-humble-ros-gz \ # Gazebo Sim package (instead of Gazebo classic)


    # Set locale
    locale-gen en_US en_US.UTF-8
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8

    # Add ROS 2 GPG key and repository
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key | apt-key add -
    echo "deb [arch=amd64] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" > /etc/apt/sources.list.d/ros2-latest.list

    # Create the pip configuration directory if it doesn't exist
    mkdir -p ~/.config/pip

    # Write the pip config file with a 600-second timeout
    echo "[global]" > ~/.config/pip/pip.conf
    echo "timeout = 2000" >> ~/.config/pip/pip.conf


    # update just the ROS Humble packages to the latest version in the snapshot repository
    apt-get update
    apt-get install -y --only-upgrade ros-${ROS_DISTRO}* 

    # We copied the full solution up to here.
    # Now we can use rosdep install to make sure all the dependecies are 
    # installed on the image.
    rosdep update --rosdistro=${ROS_DISTRO}
    # Install ROS dependencies for installed packages (ignoring source packages)
    # rosdep install -y --rosdistro=humble --ignore-src $(rosdep list --rosdistro humble)


    # Upgrade pip and install Python packages
    pip3 install --upgrade pip
    # pip3 install casadi 
    
    # Install gym-pybullet-drones
    cd /
    git clone https://github.com/utiasDSL/gym-pybullet-drones.git
    cd gym-pybullet-drones/
 


    pip3 install --upgrade pip
    pip3 install -e . # if needed, `sudo apt install build-essential` to install `gcc` and build `pybullet`
    #pip install pybullet	
    
    # Clone and install acados
    cd /
    git clone https://github.com/acados/acados.git
    cd acados
    git submodule update --init --recursive
    mkdir -p build
    cd build
    cmake -DACADOS_WITH_QPOASES=ON -DACADOS_WITH_OSQP=ON ..
    # make -j$(nproc)
    make install -j4
    cd /acados

    # install python interface for acados:
    pip install -e /acados/interfaces/acados_template

    # Set environment variables for acados
    echo 'export ACADOS_SOURCE_DIR=/acados' >> $HOME/.bashrc
    echo 'export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/acados/lib' >> $HOME/.bashrc

    # RO47005: Enable rosdep to find gym_pybullet_drones_packages
    echo 'export PATH="/.local/bin:$PATH"' >> $HOME/.bashrc
    echo 'export PATH="/gym-pybullet-drones:$PATH"' >> $HOME/.bashrc

    # Source ROS 2 setup script
    echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc


    # don't leave unneeded stuff around
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # Show the curent dir when working in the singularity image
    # This has changed in singularity 3.x and now needs to be done in the environment
    # See https://github.com/hpcng/singularity/issues/3590

    cat > /.singularity.d/env/99-zz-robprac.sh <<EOF  
PS1="Singularity:\\W> "
export PS1
EOF



%environment
    # Source ROS 2 setup script and set environment variables
    . /opt/ros/humble/setup.bash
    export ACADOS_SOURCE_DIR=/acados
    export LD_LIBRARY_PATH=/acados/lib:$LD_LIBRARY_PATH
    export PATH="/.local/bin:$PATH"
    export SIMAGE_ROS_DISTRO=${ROS_DISTRO}
    export RO47003_DIMAGE_SHA265='80a4f6329aad64f14b600133cb3fd279d0bf666feeca5abef3f10bb41b0916ea'
    # this is needed to make sure no only ROS nodes/topics runnning on the host are found
    export ROS_LOCALHOST_ONLY=1

%runscript
    # Source ROS 2 setup script and execute the command passed to the container
    . /opt/ros/humble/setup.bash
    exec "$@"

%test
    # Verify installation
    #python3 -c "import casadi; import acados_template; import gym_pybullet_drones; print('Setup successful!')"
