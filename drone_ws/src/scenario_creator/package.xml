<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scenario_creator</name>
  <version>0.0.0</version>
  <description>A python package for ROS2 to create pybullet environments for drone testing</description>
  <maintainer email="jeggenkemper@tudelft.nl">jeggenkemper</maintainer>
  <license>Apache-2.0</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <build_depend>numpy</build_depend>
  <build_depend>time</build_depend>
  <build_depend>gym_pybullet_drones</build_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
